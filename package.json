{
  "name": "@fullstack-ai-infra/ui",
  "version": "0.2.0",
  "description": "Shared design tokens, accessible React primitives, and application shell patterns for ByteFolk.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bytefolk/design-system.git"
  },
  "homepage": "https://github.com/bytefolk/design-system#readme",
  "bugs": {
    "url": "https://github.com/bytefolk/design-system/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./tailwind-preset": {
      "import": {
        "types": "./dist/tailwind-preset.d.ts",
        "default": "./dist/tailwind-preset.js"
      },
      "require": {
        "types": "./dist/tailwind-preset-require.d.cts",
        "default": "./dist/tailwind-preset-require.cjs"
      },
      "default": "./dist/tailwind-preset.js"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config vite.showcase.config.ts",
    "build": "npm run build:package && npm run build:showcase",
    "build:package": "tsup src/index.ts src/tailwind-preset.ts --format esm,cjs --dts --external react --external react-dom --clean --silent && node scripts/copy-cjs-bridge.mjs",
    "build:showcase": "vite build --config vite.showcase.config.ts",
    "preview": "vite preview --config vite.showcase.config.ts",
    "tokens:generate": "node scripts/generate-tokens-css.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:pack": "node ./scripts/test-pack-consumer.mjs",
    "check:dist-tokens": "node scripts/check-dist-tokens.mjs",
    "prepack": "npm run build:package",
    "prepublishOnly": "npm run check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run check:dist-tokens && npm run test:pack && npm run test:visual"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "overrides": {
    "tsup": {
      "esbuild": "0.28.1",
      "bundle-require": {
        "esbuild": "0.28.1"
      }
    }
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/forms": "^0.5.11",
    "antd": "^6.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.12",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^6.4.1",
    "vitest": "^5.0.0",
    "vitest-axe": "^0.1.0"
  }
}
